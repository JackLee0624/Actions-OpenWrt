#
# v2 涓轰粈涔?3.5KB锛?8.87MB 瓒?15.38MB 鈫?sysupgrade 琚潤榛樺垹闄ゃ€?# v3 鐮嶆硶锛堢洰鏍?鈮?12~14MB锛岀暀瓒充綑閲忥級锛?#   1) 鍏冲唴鏍?debug 绗﹀彿锛圕ONFIG_KERNEL_DEBUG_INFO / KALLSYMS锛夛細鎵€鏈?kmod 涓嶅啀甯﹁皟璇曟锛岀渷 2~3MB锛屾渶澶уご锛?#   2) 鍏ㄥ叧 IPv6锛圕ONFIG_IPV6 / CONFIG_KERNEL_IPV6 is not set锛夛細鐪佸唴鏍?IPv6 + kmod-nf-*6 + ip6tables + odhcp6c
#      鈥斺€?DHCPv4 鐢?dnsmasq-full锛圤penClash 渚濊禆锛屽凡閫夛級鍏滃簳锛孡AN 鐓у父鍒嗛厤 IP锛屼笉鍙楀奖鍝?#   3) luci-light 鍙栦唬瀹屾暣 luci锛氬幓鎺?luci-app-oui / luci-app-package-manager 绛?#   4) 鍏冲浣?iptables 妯″潡锛坒ullconenat/iprange/socket/extra/conntrack-extra锛夛紝淇濈暀 OpenClash 闇€瑕佺殑 TPROXY
#   5) 缁х画鍏?LEDE 榛樿鍏ㄥ妗讹紙ssr-plus/turboacc/vlmcsd/...锛?# 娉ㄦ剰锛歳uby 鏄?OpenClash 纭緷璧栵紝涓嶈兘鍒狅紙绾?1.5MB锛屽彧鑳藉繊锛夈€?# ==========================================================

# ---- 鐩爣鏈哄瀷锛氭枑璁?K2P ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# 鍗曡澶囷紝涓嶇紪澶氳澶囧悎闆嗭紙涔熺渷缂栬瘧鏃堕棿锛?# CONFIG_TARGET_MULTI_PROFILE is not set

# ---- 鍙敓鎴?squashfs 鍒锋満闀滃儚锛堜笉缂?initramfs锛岀渷鏃堕棿涔熼伩鍏嶉偅涓?20MB 骞叉壈鏂囦欢锛?---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ==========================================================
# 鍐呮牳浣撶Н鐦﹁韩锛堟渶澶уご锛丩EDE 榛樿寮€鐫€鍐呮牳 debug 绗﹀彿锛屾墍鏈?.ko 妯″潡閮藉甫璋冭瘯娈碉紝鍏虫帀鐪?2~3MB锛屼笉褰卞搷杩愯锛?# ==========================================================
