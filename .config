# ---- LuCI 缃戦〉鍚庡彴锛堟瀬绠€锛歭uci-light锛屼笉鍚?oui / package-manager锛?---
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ---- PPPoE 鎷ㄥ彿锛堝浗鍐呭甯﹀鏁拌鎷ㄥ彿锛屼繚鐣欙紱鑻ヤ綘鐢?DHCP 涓婄綉锛屾妸涓嬮潰涓夎鏀规垚 # ... is not set 鍗冲彲锛?---
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---- WiFi 鍔犲瘑锛圵PA2/WPA3锛夛細蹇呴』琛ュ洖锛?#      K2P 璁惧瀹氫箟閲屽啓浜?"-wpad-openssl" 浼氭妸 mt7621 榛樿鐨?wpad 鎽樻帀锛?#      diy-part2.sh 浼氭妸杩欎釜璐熷彿鍘绘帀锛岃繖閲屽啀鏄惧紡閫変笂锛屽弻淇濋櫓 ----
CONFIG_PACKAGE_wpad-openssl=y

# ---- 鍞竴瑕佽鐨勬彃浠讹細OpenClash ----
# 鍏朵綑渚濊禆锛坆ash / ruby / dnsmasq-full / curl / ca-bundle / ip-full / ipset / kmod-tun / unzip 绛夛級
# 鐢?make defconfig 鑷姩琛ラ綈锛屼笉瑕佹墜鍔ㄥ嬀鍒殑
CONFIG_PACKAGE_luci-app-openclash=y

# ---- 涓枃鐣岄潰锛圤penClash 鑷甫涓枃锛岃繖閲岀鐨勬槸绯荤粺椤甸潰鐨勪腑鏂囧寘锛?---
CONFIG_LUCI_LANG_zh_Hans=y

