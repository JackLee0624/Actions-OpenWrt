# ==========================================================
# K2P A1/A2 (MediaTek MT7621) 最小化配置 —— 只装 OpenClash
# GitHub 上文件名必须是 .config，放在仓库根目录
# 刷入前请确认固件 < 16MB（K2P 闪存只有 16MB）
# ==========================================================

# ---- 目标平台：斐讯 K2P ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ---- 中文 LuCI 网页后台（显式带上，确保后台可用）----
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 唯一要装的插件：OpenClash ----
# 其余依赖由 make defconfig 自动补齐，不要再手动勾其它插件
CONFIG_PACKAGE_luci-app-openclash=y

# ---- 以下两行是“省空间”备用开关，爆 16MB 时再用 ----
# 关掉 https 后台（用 http 进 192.168.1.1 即可）
# CONFIG_PACKAGE_luci-ssl-openssl is not set
# CONFIG_PACKAGE_luci-ssl is not set
