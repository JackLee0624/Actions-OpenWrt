# ==========================================================
# 斐讯 K2P A1/A2（MT7621，16MB 闪存）—— 只装 OpenClash（瘦身版）
# 放在仓库根目录，文件名必须是 .config
#
# 硬性上限：squashfs-sysupgrade.bin 必须 <= 15744k（设备定义 IMAGE_SIZE）
# 超限的话，LEDE 的 Build/check-size 会直接 rm -f 把镜像删掉、且不报错，
# 现象就是 Artifacts 里只有 initramfs-kernel.bin、没有 sysupgrade。
# ==========================================================

# ---- 目标机型：斐讯 K2P ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ---- 只生成 squashfs 刷机镜像（显式打开，别省）----
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 不编译 initramfs 镜像：省编译时间，也避免再出现那个 20MB 的干扰文件
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ---- LuCI 网页后台（最小可用集）----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ---- WiFi 加密（WPA2/WPA3）：必须补回！
#      K2P 设备定义里写了 "-wpad-openssl"，会把 mt7621 默认的 wpad 摘掉，
#      diy-part2.sh 会把这个负号去掉，这里再显式选上，双保险。
CONFIG_PACKAGE_wpad-openssl=y

# ---- 唯一要装的插件：OpenClash ----
# 其余依赖（bash / ruby / coreutils / curl / dnsmasq-full / ipset 等）
# 由 make defconfig 自动补齐，不要手动勾别的
CONFIG_PACKAGE_luci-app-openclash=y

# ---- 中文界面（OpenClash 自带中文，这里管的是系统页面的中文包）----
CONFIG_LUCI_LANG_zh_Hans=y

# ==========================================================
# 瘦身关键：关掉 LEDE 默认硬塞进来的“路由器全家桶”
# 来源：include/target.mk 里的 DEFAULT_PACKAGES.router
# 这些行必须保留（# 开头的 "is not set" 是有效指令，不是注释）
# ==========================================================
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_ddns-scripts_aliyun is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set
# CONFIG_PACKAGE_coremark is not set

# ==========================================================
# 二级保险：如果编译日志里还是提示 "is too big"，
# 把下面的行首 "###" 改成 "#" 逐条启用（每条约省 100~400KB）
# 注意别写成 "# CONFIG..." —— 那样会立刻生效
# ==========================================================
### CONFIG_PACKAGE_odhcp6c is not set
### CONFIG_PACKAGE_odhcpd-ipv6only is not set
### CONFIG_PACKAGE_ip6tables is not set
### CONFIG_PACKAGE_kmod-ipt-nat6 is not set
### CONFIG_PACKAGE_luci-proto-ipv6 is not set
### CONFIG_PACKAGE_luci-app-package-manager is not set
### CONFIG_LUCI_LANG_zh_Hans is not set
